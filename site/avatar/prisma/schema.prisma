// AVATAR Platform - Complete Prisma Schema
// PostgreSQL datasource for AVATAR gaming platform
// Generated: 2024
// Version: 2.0.0 - FINAL VALIDATED SCHEMA

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
/// Initializes:
/// - Base roles (Founder, Director, Manager, Admin, Cashier, Staff, Customer)
/// - Permissions (booking, order, payment, branch, finance, analytics, etc.)
/// - Product categories (Drinks, Food, Snacks, Accessories, Merchandise)
/// - Role-Permission mappings

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

